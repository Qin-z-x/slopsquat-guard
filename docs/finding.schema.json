{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Qin-Z-x/slopsquat-guard/docs/finding.schema.json",
  "title": "slopsquat-guard finding",
  "description": "One dependency-risk finding produced by scan_path()/verify_package().",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "ecosystem", "name", "normalized", "source_file", "line", "message", "data"],
  "properties": {
    "code": { "type": "string", "pattern": "^SQ-[A-Z-]+$" },
    "severity": { "type": "string", "enum": ["low", "medium", "high"] },
    "ecosystem": { "type": "string", "enum": ["pypi", "npm"] },
    "name": { "type": "string", "minLength": 1 },
    "normalized": { "type": "string", "minLength": 1 },
    "source_file": { "type": "string" },
    "line": { "type": "integer", "minimum": 0 },
    "message": { "type": "string", "minLength": 1 },
    "data": { "type": "object" }
  }
}
